#include<iostream>
#include<vector>
using namespace std;

class Solution {
public:
    vector<int> majorityElement(vector<int>& nums) {
        vector<int>ans;
        int n=nums.size();
        int cnt1=0,cnt2=0;
        int candidate1=0, candidate2=0;
        for(int num:nums){
            if(num==candidate1) cnt1++;
            else if(num==candidate2) cnt2++;
            else if(cnt1==0) {
                cnt1++;
                candidate1=num;
            }
            else if(cnt2==0){
                cnt2++;
                candidate2=num;
            }else{
                cnt1--;
                cnt2--;
            }
            
        }
        cnt1=0;
        cnt2=0;
        for(int num:nums){
            if(num==candidate1) cnt1++;
            else if(candidate2==num) cnt2++;
        }if(cnt1>n/3) ans.push_back(candidate1);
        if(cnt2>n/3) ans.push_back(candidate2);

        return ans;
    }
};
#include<iostream>
#include<vector>
using namespace std;

class Solution {
public:
    void nextPermutation(vector<int>& nums) {
        int i=nums.size()-1;
        while(i>0&&nums[i]<=nums[i-1]) i--;
        if(i==0){
            reverse(nums.begin(),nums.end());
            return;
        }
        for(int j=nums.size()-1;j>=i;j--){
            if(nums[j]>nums[i-1]){
                swap(nums[i-1],nums[j]);
                break;
            }
        }
        reverse(nums.begin()+i,nums.end());
    }
};
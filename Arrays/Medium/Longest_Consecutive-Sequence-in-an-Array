#include<iostream>
#include<vector>        
#include<unordered_set>
using namespace std;

class Solution {
public:
    int longestConsecutive(vector<int>& nums) {
        int mx=0;
        unordered_set<int>st(nums.begin(),nums.end());
        for(int i:st){
            if(st.find(i-1)==st.end()){
                int curr=1;
                while(st.find(i+1)!=st.end()){
                    curr++;
                    i++;
                }mx=max(mx,curr);
            }
        }
        return mx;
    }
};
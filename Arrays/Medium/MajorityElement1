#include<iostream>
#include<vector>
using namespace std;

class Solution {
public:
    int majorityElement(vector<int>& nums) {
        int candidate,cnt=0;
        for(int i=0;i<nums.size();i++){
            if(cnt==0) candidate=nums[i];
            if(candidate==nums[i]) cnt++;
            else cnt--;
        }return candidate;
    }
};
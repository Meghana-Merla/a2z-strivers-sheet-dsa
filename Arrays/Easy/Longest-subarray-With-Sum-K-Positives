#include<iostream>
#include<vector>
using namespace std;

#define ll long long
class Solution {
public:
    int longestSubarray(vector<int>& nums, int k) {
        int ans=0, sum=0, n=nums.size();
        int i=0;
        for(int j=0;j<n;j++){
            sum+=nums[j];
            if(sum==k) ans=max(ans,j-i+1);
            while(sum>k) sum-=nums[i++];
        }return ans;
    }
};

#include<iostream>
#include<vector>
#include<unordered_map>
using namespace std;

#define ll long long
class Solution {
public:
    int longestSubarray(vector<int>&nums,int k){
        int ans=0,n=nums.size();
        unordered_map<int,int> mp;
        int sum=0;
        for(int i=0;i<n;i++){
            sum+=nums[i];
            if(sum==k) ans=i+1;
            if(mp.find(sum-k)!=mp.end()) ans=max(ans,i-mp[sum-k]);
            if(mp.find(sum)==mp.end()) mp[sum]=i;

        }
        return ans;
    }
};